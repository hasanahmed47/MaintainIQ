PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=your_mongodb_connection_string

# Long random string used to sign JWTs
JWT_SECRET=change_this_to_a_long_random_string

# OpenAI key for AI Issue Triage (optional — triage falls back gracefully without it)
OPENAI_API_KEY=your_openai_key

# Optional — enables Google Sign-In.
# Create a free OAuth Client ID (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173 (+ your deployed frontend URL)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# Optional — secret code that allows signing up directly as an admin.
# Leave empty to disable admin self-signup (recommended for production).
ADMIN_SIGNUP_CODE=
