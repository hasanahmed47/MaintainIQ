# Backend API base URL (leave empty to use the default below in local dev)
VITE_API_URL=http://localhost:5000/api

# Optional — enables the Google Sign-In button on Login/Signup.
# Create it at https://console.cloud.google.com/apis/credentials (OAuth Client ID, type "Web application"),
# add http://localhost:5173 to Authorized JavaScript origins,
# and use the SAME client ID as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=
